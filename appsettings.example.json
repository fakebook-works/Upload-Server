{
  "Jwt": {
    "Issuer": "fakebook-auth",
    "Audience": "fakebook",
    "SigningKey": "replace-with-a-32-byte-minimum-development-key"
  },
  "AuthService": {
    "Url": "http://localhost:1001/graphql"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "UploadStorage": {
    "RootPath": ".data/media",
    "StagedUploadsEnabled": true,
    "PendingLifetimeMinutes": 1440,
    "CleanupIntervalMinutes": 10
  },
  "InternalApi": {
    "SharedSecret": "replace-with-a-32-byte-minimum-upload-internal-key"
  }
}
